# =======================================================
# APEX FINTECH AI AGENT - ENVIRONMENT CONFIGURATION
# =======================================================
# Reference template only. The real local config is the `.env` file in the
# project root. Every integration is optional: with no API keys the app runs
# on the built-in local reasoning engine and local Hindsight memory, so the
# demo works fully offline.
# =======================================================

# -------------------------------------------------------
# LLM
# -------------------------------------------------------
# Set to groq for the recommended provider. If no usable API key
# is configured, the app uses its built-in local reasoning engine.
LLM_PROVIDER=groq

# Groq (recommended) - free API key at https://console.groq.com/
GROQ_API_KEY=ggsk_XzXV6MIR0kxHRee1xDeAWGdyb3FYqQ1GZ0h0Avwce1gVtXAxHJpX
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (optional alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------
# Hindsight Cloud Memory (optional)
# -------------------------------------------------------
# Hindsight Cloud is optional. Set HINDSIGHT_API_KEY to enable it;
# if the key is blank or the cloud is unreachable, the app falls
# back to the built-in local engine.
# Local memory persists to data/hindsight_local_banks.json.
# Hindsight Cloud dashboard: https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_be3e89fe4776c08883856ec1d5912588_d55c1a9526b52ead
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# -------------------------------------------------------
# Server
# -------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# -------------------------------------------------------
# Persistence & Sessions
# -------------------------------------------------------
# SQLite database used for login sessions and chat history.
DATABASE_PATH=data/clientcare.db

# How long a login session stays valid, in hours.
SESSION_TTL_HOURS=12

# Set to 1 only when serving over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=0

# -------------------------------------------------------
# Demo Password Overrides (optional)
# -------------------------------------------------------
# Defaults match the accounts shown on the login screen:
#   aarav  / Apex@101
#   rajesh / Apex@102
#   priya  / Apex@103
# Override here if you want different local passwords.
# Never commit real production credentials.
DEMO_AARAV_PASSWORD=Apex@101
DEMO_RAJESH_PASSWORD=Apex@102
DEMO_PRIYA_PASSWORD=Apex@103
